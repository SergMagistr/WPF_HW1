<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="320" Width="350">
    <Grid>
        <!-- Прямоугольник с изменяемым цветом -->
        <Rectangle x:Name="ColorRect"
                Width="300" Height="150"
                Stroke="Black" StrokeThickness="1"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                Margin="10,10,0,0"/>

        <!-- Ползунки для RGB -->
        <!-- Красный канал -->
        <TextBlock Text="R:" Width="30" Margin="10,170,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Slider x:Name="RedSlider" Width="200" Margin="50,170,0,0"
                Minimum="0" Maximum="255" Value="128"                
                VerticalAlignment="Top" HorizontalAlignment="Left" 
                ValueChanged="Slider_ValueChanged"
                
                />
        <TextBlock x:Name="RedValue" Text="128" Width="30" Margin="260,170,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <!-- Зеленый канал -->
        <TextBlock Text="G:" Width="30" Margin="10,190,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Slider x:Name="GreenSlider" Width="200"
                Minimum="0" Maximum="255" Value="128" Margin="50,190,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"
                ValueChanged="Slider_ValueChanged"/>
        <TextBlock x:Name="GreenValue" Text="128" Width="30" Margin="260,190,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"/>

        <!-- Синий канал -->
        <TextBlock Text="B:" Width="30" Margin="10,210,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left"/>
        <Slider x:Name="BlueSlider" Width="200" Margin="50,210,0,0"
                Minimum="0" Maximum="255" Value="128"                
                VerticalAlignment="Top" HorizontalAlignment="Left"                
                ValueChanged="Slider_ValueChanged"/>
        <TextBlock x:Name="BlueValue" Text="128" Width="30" Margin="260,210,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Left" />
    </Grid>
</Window>
