<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Title="Мини калькулятор" Height="200" Width="350">
    <Grid>
        <TextBox x:Name="Num1TexBox"
                HorizontalAlignment="Left" 
                 Margin="10,10,0,0" 
                 TextWrapping="Wrap" 
                 VerticalAlignment="Top" 
                 Width="150" 
                 Height="20" FontSize="16"
                 TextAlignment="Center"/>
        <TextBox 
                x:Name="Num2TexBox"
                HorizontalAlignment="Left" 
                 Margin="170,10,0,0" 
                 TextWrapping="Wrap" 
                 VerticalAlignment="Top" 
                 Width="150" 
                 Height="20" FontSize="16"
            TextAlignment="Center"/>
        <Button 
            Content="+" 
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="10,40,0,0" 
            Width="150"
            Height="20" 
            Click="Button_Click"/>
        <Button 
            Content="-" 
            HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="10,70,0,0" 
            Width="150"
            Height="20"
            Click="Button_Click"
            />
        <Button 
           Content="*" 
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="170,40,0,0"
           Width="150"
           Height="20"
            Click="Button_Click"/>
         <Button 
           Content="/" 
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Margin="170,70,0,0"
           Width="150"
           Height="20"
            Click="Button_Click"/>
        <TextBlock 
            x:Name="ResultText"
            HorizontalAlignment="Center" 
            Margin="0,115,0,0" 
            TextWrapping="Wrap" 
            Text="Результат: 0" 
            VerticalAlignment="Top"
            />

    </Grid>
</Window>
